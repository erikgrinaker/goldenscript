# Comment at start.
#
# Comments can contain arbitrary characters, like 👋 and	(tab).

# Comment before command.
command id=1
---
Command {
    name: "command",
    args: [
        KeyValue(
            "id",
            "1",
        ),
    ],
    context: Context {
        prefix: None,
        tags: {},
        silent: false,
        fail: false,
        line_number: 6,
    },
}

command id=2 # Comment beside command.
---
Command {
    name: "command",
    args: [
        KeyValue(
            "id",
            "2",
        ),
    ],
    context: Context {
        prefix: None,
        tags: {},
        silent: false,
        fail: false,
        line_number: 25,
    },
}

command id=3
# Comment after command.
---
Command {
    name: "command",
    args: [
        KeyValue(
            "id",
            "3",
        ),
    ],
    context: Context {
        prefix: None,
        tags: {},
